# ─── API backend ─────────────────────────────────────────────────────────────
# URL of the running FastAPI backend (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Supabase (for future direct Supabase client usage) ──────────────────────
# These are not used by the current frontend — the frontend talks to FastAPI.
# Fill them in if you add the Supabase JS client later.
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
