# ─── Gemini / LLM ────────────────────────────────────────────────────────────
# Fallback key used only if no per-request key is passed in the X-Gemini-Api-Key
# header. In production users supply their own key and this is not required.
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Database ─────────────────────────────────────────────────────────────────
# Direct PostgreSQL connection string from your Supabase project.
# Supabase Dashboard → Settings → Database → Connection string (URI mode).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ─── Supabase (for reference / future Supabase client usage) ─────────────────
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
